# Provider options: gmail, outlook, custom
EMAIL_PROVIDER=gmail

# Gmail IMAP
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# Outlook / Hotmail IMAP example
# EMAIL_PROVIDER=outlook
# EMAIL_IMAP_HOST=imap-mail.outlook.com
# EMAIL_IMAP_PORT=993

EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password_or_password

# Mailbox folder to search
EMAIL_MAILBOX=INBOX

# Filters. Leave blank to ignore a filter.
TARGET_FROM=supplier@example.com
TARGET_TO=
TARGET_SUBJECT=Daily Supplier Stock File
TARGET_SUBJECT_MODE=contains

# Date filtering
# Options: blank, today, yesterday, last_n_days
TARGET_DATE_MODE=last_n_days
TARGET_LAST_N_DAYS=7

# Whether to search only unread emails
ONLY_UNREAD=false

# Attachment filters
# Comma-separated file extensions. Example: .csv,.xlsx,.zip
TARGET_ATTACHMENT_EXTENSIONS=.csv

# Comma-separated filename keywords. Leave blank to accept any filename matching extension.
TARGET_ATTACHMENT_NAME_CONTAINS=

# If true, extracts zip files after download
EXTRACT_ZIP_FILES=true

# If true, keeps the original zip after extraction
KEEP_ZIP_FILES=true

# Download behaviour
DOWNLOAD_DIR=downloads/supplier/latest
OVERWRITE_EXISTING=true
ADD_TIMESTAMP_TO_FILENAME=false

# Post-processing email behaviour
MARK_AS_READ=false
MOVE_PROCESSED_EMAIL=false
PROCESSED_MAILBOX=Processed

# Logs
LOG_DIR=logs

# Email body options
# Use this when the useful supplier content is inside the email body instead of an attachment.
TARGET_BODY_CONTAINS=
SAVE_BODY_TEXT=false
SAVE_BODY_HTML=false
SCRAPE_BODY_CONTENT=false
BODY_OUTPUT_DIR=downloads/email_bodies

# Optional body scraping filters.
# Example: StockCode,Qty,Warehouse or leave blank to capture all non-empty lines.
BODY_LINE_CONTAINS=

# For simple key/value email bodies such as "StockCode: ABC123".
BODY_KEY_VALUE_SEPARATOR=:
